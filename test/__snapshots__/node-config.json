{
  "env": {
    "node": true,
  },
  "extends": [
    {
      "categories": {
        "correctness": "deny",
        "nursery": "allow",
        "pedantic": "warn",
        "perf": "warn",
        "restriction": "warn",
        "style": "warn",
        "suspicious": "warn",
      },
      "options": {
        "typeAware": true,
      },
      "overrides": [
        {
          "files": [
            "**/*.d.ts",
          ],
          "rules": {
            "import/unambiguous": "allow",
          },
        },
        {
          "files": [
            "**/oxlint.config.ts",
            "**/oxlint.config.mts",
          ],
          "rules": {
            "import/no-default-export": "allow",
          },
        },
      ],
      "plugins": [
        "import",
        "oxc",
        "typescript",
        "unicorn",
      ],
      "rules": {
        "curly": [
          "deny",
          "all",
        ],
        "eslint/arrow-body-style": "allow",
        "eslint/capitalized-comments": "allow",
        "eslint/func-style": "allow",
        "eslint/id-length": "allow",
        "eslint/init-declarations": "allow",
        "eslint/max-lines": [
          "warn",
          {
            "max": 500,
          },
        ],
        "eslint/max-lines-per-function": [
          "warn",
          {
            "max": 100,
          },
        ],
        "eslint/no-continue": "allow",
        "eslint/no-duplicate-imports": [
          "deny",
          {
            "allowSeparateTypeImports": true,
          },
        ],
        "eslint/no-else-return": "allow",
        "eslint/no-inline-comments": "allow",
        "eslint/no-lonely-if": "allow",
        "eslint/no-magic-numbers": "allow",
        "eslint/no-multi-assign": [
          "warn",
          {
            "ignoreNonDeclaration": true,
          },
        ],
        "eslint/no-nested-ternary": "allow",
        "eslint/no-plusplus": "allow",
        "eslint/no-ternary": "allow",
        "eslint/no-undefined": "allow",
        "eslint/no-unused-vars": [
          "deny",
          {
            "args": "all",
            "argsIgnorePattern": "^_",
            "caughtErrors": "all",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_",
            "ignoreRestSiblings": true,
            "varsIgnorePattern": "^_",
          },
        ],
        "eslint/no-use-before-define": "allow",
        "eslint/no-void": [
          "warn",
          {
            "allowAsStatement": true,
          },
        ],
        "eslint/no-warning-comments": "allow",
        "eslint/one-var": "allow",
        "eslint/prefer-destructuring": "allow",
        "eslint/sort-imports": [
          "deny",
          {
            "ignoreCase": true,
            "ignoreDeclarationSort": true,
          },
        ],
        "eslint/sort-keys": "allow",
        "import/consistent-type-specifier-style": [
          "warn",
          "prefer-top-level-if-only-type-imports",
        ],
        "import/exports-last": "allow",
        "import/group-exports": "allow",
        "import/no-default-export": "warn",
        "import/no-duplicates": "allow",
        "import/no-named-export": "allow",
        "import/no-nodejs-modules": "allow",
        "import/no-relative-parent-imports": "allow",
        "import/no-unassigned-import": "allow",
        "import/prefer-default-export": "allow",
        "no-underscore-dangle": [
          "deny",
          {
            "allowFunctionParams": true,
          },
        ],
        "oxc/no-async-await": "allow",
        "oxc/no-optional-chaining": "allow",
        "oxc/no-rest-spread-properties": "allow",
        "typescript/consistent-return": "allow",
        "typescript/consistent-type-definitions": "allow",
        "typescript/consistent-type-imports": [
          "deny",
          {
            "disallowTypeAnnotations": false,
            "prefer": "type-imports",
          },
        ],
        "typescript/explicit-function-return-type": "allow",
        "typescript/explicit-member-accessibility": "deny",
        "typescript/explicit-module-boundary-types": "allow",
        "typescript/no-empty-interface": "allow",
        "typescript/no-empty-object-type": "allow",
        "typescript/prefer-readonly-parameter-types": "allow",
        "typescript/switch-exhaustiveness-check": [
          "warn",
          {
            "considerDefaultExhaustiveForUnions": true,
          },
        ],
        "unicorn/empty-brace-spaces": "allow",
        "unicorn/filename-case": "allow",
        "unicorn/no-lonely-if": "allow",
        "unicorn/no-nested-ternary": "allow",
        "unicorn/no-useless-undefined": "allow",
        "unicorn/no-zero-fractions": "allow",
      },
    },
  ],
  "plugins": [
    "node",
  ],
}