{
  "name": "@shufflies/oxlint-config",
  "version": "0.0.0-semantically-released",
  "description": "Personal reusable oxlint configuration",
  "keywords": [
    "oxlint",
    "oxlint-config"
  ],
  "license": "MIT",
  "author": "Royston Shufflebotham",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoystonS/shufflies-oxlint-config.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rimraf lib",
    "pretest": "npm run build",
    "test": "npm run test:base && npm run test:react && npm run test:node",
    "test:base": "oxlint test/base-fodder --config test/base.config.mjs --report-unused-disable-directives-severity error --max-warnings=0",
    "test:react": "oxlint test/react-fodder --config test/react.config.mjs --report-unused-disable-directives-severity error --max-warnings=0",
    "test:node": "oxlint test/node-fodder --config test/node.config.mjs --report-unused-disable-directives-severity error --max-warnings=0",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir lib/types -p src",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs -p src",
    "build:esm": "tsc --module nodenext --outDir lib/esm -p src",
    "build": "concurrently -n cjs,esm,types \"npm:build:cjs\" \"npm:build:esm\" \"npm:build:types\"",
    "format:check": "oxfmt --check",
    "format": "oxfmt"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "rimraf": "^6.1.3",
    "semantic-release": "25.0.9"
  },
  "peerDependencies": {
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2002"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "packageManager": "npm@12.0.2"
}
